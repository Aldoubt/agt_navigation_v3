<?xml version="1.0"?>
<package format="3">
  <name>agt_localization_ros</name>
  <version>0.1.0</version>
  <description>Compatibility and shadow-only ROS layer for the staged AGT Localization v1 migration.</description>
  <maintainer email="contact@aldoubt.com">AGT</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_python</buildtool_depend>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>nav_msgs</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>agt_robot_interfaces</exec_depend>
  <exec_depend>agt_localization_interfaces</exec_depend>
  <exec_depend>agt_localization_core</exec_depend>
  <exec_depend>ament_index_python</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <test_depend>python3-pytest</test_depend>
  <export><build_type>ament_python</build_type></export>
</package>
