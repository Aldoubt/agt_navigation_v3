<?xml version="1.0"?>
<package format="3">
  <name>agt_fastlio_adapter</name>
  <version>0.1.0</version>
  <description>Frame-checked adapter from a selected FAST-LIO2 odometry topic to AGT canonical local odometry.</description>
  <maintainer email="contact@aldoubt.com">AGT</maintainer>
  <license>Apache-2.0</license>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>nav_msgs</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>tf2_ros</exec_depend>
  <exec_depend>agt_batch_lio_adapter</exec_depend>
  <exec_depend>agt_robot_interfaces</exec_depend>
  <exec_depend>ament_index_python</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <test_depend>python3-pytest</test_depend>
  <test_depend>tf2_msgs</test_depend>
  <export><build_type>ament_python</build_type></export>
</package>
