# AGT field hardware baseline. Shell-compatible on purpose.
# Keep only physical/wiring constants here; algorithm tuning belongs in package YAML files.
AGT_MID360_IP=192.168.1.117
AGT_CAN_IFACE=can0
AGT_CAN_BITRATE=50000
AGT_CAN_RESTART_MS=100

# The host Ethernet address is installation-specific. Do not silently force it.
# The Livox MID360 and host NIC must be on the same subnet. Example only:
# AGT_LIDAR_HOST_IP=192.168.1.5
