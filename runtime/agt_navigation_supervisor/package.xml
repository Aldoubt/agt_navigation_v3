<?xml version="1.0"?>
<package format="3">
  <name>agt_navigation_supervisor</name>
  <version>0.4.0</version>
  <description>Navigation V4 sensor, odometry, localization and Nav2 health supervisor.</description>
  <maintainer email="contact@aldoubt.com">AGT</maintainer>
  <license>Apache-2.0</license>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>agt_navigation_interfaces</exec_depend>
