<?xml version="1.0"?>
<sdf version="1.6">
  <world name="agt_mapping">
    <gravity>0 0 -9.80665</gravity>
    <physics type="ode"><real_time_update_rate>1000</real_time_update_rate><max_step_size>0.001</max_step_size></physics>
    <include><uri>model://ground_plane</uri></include>
    <include><uri>model://sun</uri></include>

    <!-- Asymmetric, tree-like and wall-like geometry for nontrivial LIO/BBS/GICP. -->
    <model name="north_wall"><static>true</static><pose>0 5.2 0.8 0 0 0</pose><link name="link"><collision name="c"><geometry><box><size>5.0 0.35 1.6</size></box></geometry></collision><visual name="v"><geometry><box><size>5.0 0.35 1.6</size></box></geometry></visual></link></model>
    <model name="west_wall"><static>true</static><pose>-6.0 0.5 0.9 0 0 0.15</pose><link name="link"><collision name="c"><geometry><box><size>0.35 4.5 1.8</size></box></geometry></collision><visual name="v"><geometry><box><size>0.35 4.5 1.8</size></box></geometry></visual></link></model>
    <model name="east_box"><static>true</static><pose>6.0 1.5 0.7 0 0 0.4</pose><link name="link"><collision name="c"><geometry><box><size>1.6 1.0 1.4</size></box></geometry></collision><visual name="v"><geometry><box><size>1.6 1.0 1.4</size></box></geometry></visual></link></model>
    <model name="south_bar"><static>true</static><pose>1.0 -5.0 0.55 0 0 -0.2</pose><link name="link"><collision name="c"><geometry><box><size>3.0 0.5 1.1</size></box></geometry></collision><visual name="v"><geometry><box><size>3.0 0.5 1.1</size></box></geometry></visual></link></model>
    <model name="tree_a"><static>true</static><pose>-5.0 -3.6 1.3 0 0 0</pose><link name="link"><collision name="c"><geometry><cylinder><radius>0.22</radius><length>2.6</length></cylinder></geometry></collision><visual name="v"><geometry><cylinder><radius>0.22</radius><length>2.6</length></cylinder></geometry></visual></link></model>
    <model name="tree_b"><static>true</static><pose>5.2 -3.7 1.5 0 0 0</pose><link name="link"><collision name="c"><geometry><cylinder><radius>0.32</radius><length>3.0</length></cylinder></geometry></collision><visual name="v"><geometry><cylinder><radius>0.32</radius><length>3.0</length></cylinder></geometry></visual></link></model>
    <model name="tree_c"><static>true</static><pose>-4.8 3.8 1.1 0 0 0</pose><link name="link"><collision name="c"><geometry><cylinder><radius>0.18</radius><length>2.2</length></cylinder></geometry></collision><visual name="v"><geometry><cylinder><radius>0.18</radius><length>2.2</length></cylinder></geometry></visual></link></model>
    <model name="tree_d"><static>true</static><pose>4.7 4.0 1.7 0 0 0</pose><link name="link"><collision name="c"><geometry><cylinder><radius>0.27</radius><length>3.4</length></cylinder></geometry></collision><visual name="v"><geometry><cylinder><radius>0.27</radius><length>3.4</length></cylinder></geometry></visual></link></model>
    <model name="landmark_column"><static>true</static><pose>0.8 4.0 1.0 0 0 0</pose><link name="link"><collision name="c"><geometry><box><size>0.55 0.55 2.0</size></box></geometry></collision><visual name="v"><geometry><box><size>0.55 0.55 2.0</size></box></geometry></visual></link></model>
    <model name="low_block"><static>true</static><pose>-1.5 -4.0 0.3 0 0 0.7</pose><link name="link"><collision name="c"><geometry><box><size>1.2 0.8 0.6</size></box></geometry></collision><visual name="v"><geometry><box><size>1.2 0.8 0.6</size></box></geometry></visual></link></model>
  </world>
</sdf>
