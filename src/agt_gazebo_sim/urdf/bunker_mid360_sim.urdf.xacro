<?xml version="1.0"?>
<robot name="agt_bunker_sim" xmlns:xacro="http://www.ros.org/wiki/xacro">
  <link name="base_link">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="80.0"/>
      <inertia ixx="6.0" ixy="0" ixz="0" iyy="8.0" iyz="0" izz="10.0"/>
    </inertial>
    <collision><geometry><box size="1.023 0.778 0.400"/></geometry></collision>
    <visual>
      <geometry><box size="1.023 0.778 0.400"/></geometry>
      <material name="gray"><color rgba="0.25 0.25 0.25 1"/></material>
    </visual>
  </link>

  <!-- Physical simulation IMU pose matches the inverse of the production
       navigation_lio body->base_link calibration. -->
  <link name="imu_link">
    <inertial>
      <mass value="0.05"/>
      <inertia ixx="0.0001" ixy="0" ixz="0" iyy="0.0001" iyz="0" izz="0.0001"/>
    </inertial>
  </link>
  <joint name="base_to_imu" type="fixed">
    <parent link="base_link"/><child link="imu_link"/>
    <origin xyz="0.25960015 -0.02326770 0.45244229" rpy="-0.00064287 0.20087284 0.00313534"/>
  </joint>

  <!-- Batch-LIO production extrinsic_T: IMU/body -> LiDAR. -->
  <link name="livox_frame"/>
  <joint name="imu_to_livox" type="fixed">
    <parent link="imu_link"/><child link="livox_frame"/>
    <origin xyz="0.011 0.02329 -0.04412" rpy="0 0 0"/>
  </joint>

  <gazebo>
    <plugin name="agt_planar_move" filename="libgazebo_ros_planar_move.so">
      <ros>
        <remapping>cmd_vel:=/mux/cmd_vel</remapping>
        <remapping>odom:=/sim/ground_truth_odom</remapping>
      </ros>
      <update_rate>100</update_rate>
      <publish_rate>50</publish_rate>
      <publish_odom>true</publish_odom>
      <publish_odom_tf>false</publish_odom_tf>
      <odometry_frame>sim_world</odometry_frame>
      <robot_base_frame>base_link</robot_base_frame>
      <covariance_x>0.000001</covariance_x>
      <covariance_y>0.000001</covariance_y>
      <covariance_yaw>0.00001</covariance_yaw>
    </plugin>
  </gazebo>

  <gazebo reference="imu_link">
    <sensor name="imu_sensor" type="imu">
      <always_on>true</always_on><update_rate>200</update_rate><visualize>false</visualize>
      <plugin name="agt_gazebo_imu" filename="libgazebo_ros_imu_sensor.so">
        <ros><remapping>~/out:=/sim/imu/data</remapping></ros>
        <initial_orientation_as_reference>false</initial_orientation_as_reference>
      </plugin>
    </sensor>
  </gazebo>

  <gazebo reference="livox_frame">
    <sensor type="ray" name="livox_frame">
      <pose>0 0 0 0 0 0</pose><always_on>true</always_on><visualize>false</visualize><update_rate>10</update_rate>
      <plugin name="agt_mid360_plugin" filename="libros2_livox.so">
        <ray>
          <scan>
            <horizontal><samples>100</samples><resolution>1</resolution><min_angle>0</min_angle><max_angle>6.283185307</max_angle></horizontal>
            <vertical><samples>360</samples><resolution>1</resolution><min_angle>-0.126013</min_angle><max_angle>0.963770</max_angle></vertical>
          </scan>
          <range><min>0.3</min><max>40.0</max><resolution>0.01</resolution></range>
          <noise><type>gaussian</type><mean>0.0</mean><stddev>0.002</stddev></noise>
        </ray>
        <samples>8000</samples><downsample>1</downsample><scan_period_sec>0.1</scan_period_sec>
        <csv_file_name>$(find ros2_livox_simulation)/scan_mode/mid360.csv</csv_file_name>
        <topic>/agt/sensors/lidar/custom</topic>
      </plugin>
    </sensor>
  </gazebo>
</robot>
