<?xml version="1.0"?>
<package format="3">
  <name>agt_gazebo_sim</name>
  <version>0.1.0</version>
  <description>Gazebo Classic integration harness for AGT mapping and Nav2 acceptance.</description>
  <maintainer email="contact@aldoubt.com">AGT</maintainer>
  <license>Apache-2.0</license>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>nav_msgs</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>nav2_msgs</exec_depend>
  <exec_depend>gazebo_ros</exec_depend>
  <exec_depend>robot_state_publisher</exec_depend>
  <exec_depend>xacro</exec_depend>
  <exec_depend>ros2_livox_simulation</exec_depend>
  <exec_depend>agt_mapping_bringup</exec_depend>
  <exec_depend>agt_system_bringup</exec_depend>
  <export><build_type>ament_python</build_type></export>
