<?xml version="1.0"?>
<package format="3">
  <name>agt_navigation_runtime</name>
  <version>0.1.0</version>
  <description>Inspection mission orchestration for Nav2, camera-gimbal capability, RTK metadata and HMI.</description>
  <maintainer email="dev@agt.local">AGT Robotics</maintainer>
  <license>Apache-2.0</license>
  <buildtool_depend>ament_python</buildtool_depend>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>std_srvs</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>nav2_msgs</exec_depend>
  <exec_depend>tf2_ros</exec_depend>
  <exec_depend>agt_robot_interfaces</exec_depend>
  <exec_depend>camera_gimbal_interfaces</exec_depend>
  <exec_depend>python3-yaml</exec_depend>
  <test_depend>ament_pytest</test_depend>
  <export><build_type>ament_python</build_type></export>
</package>
