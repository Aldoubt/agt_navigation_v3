<?xml version="1.0"?>
<package format="3">
  <name>agt_mapping_bringup</name>
  <version>0.1.0</version>
  <description>Mapping-mode composition for FAST-LIO2 + PGO/HBA and AGT map conversion.</description>
  <maintainer email="contact@aldoubt.com">AGT</maintainer>
  <license>Apache-2.0</license>
  <buildtool_depend>ament_cmake</buildtool_depend>
  <exec_depend>ament_index_python</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>fastlio2</exec_depend>
  <exec_depend>pgo</exec_depend>
  <exec_depend>hba</exec_depend>
  <exec_depend>agt_map_converter</exec_depend>
  <export><build_type>ament_cmake</build_type></export>
</package>
