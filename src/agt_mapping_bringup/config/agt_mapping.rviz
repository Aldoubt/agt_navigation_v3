Panels:
  - Class: rviz_common/Displays
    Name: Displays
  - Class: rviz_common/Tool Properties
    Name: Tool Properties
  - Class: rviz_common/Views
    Name: Views
  - Class: rviz_common/Time
    Name: Time
Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz_default_plugins/Grid
      Name: Grid
      Enabled: true
      Cell Size: 1
    - Class: rviz_default_plugins/TF
      Name: TF
      Enabled: true
      Show Axes: true
      Show Names: false
    - Class: rviz_default_plugins/RobotModel
      Name: RobotModel
      Enabled: true
      Description Topic:
        Value: /robot_description
    - Class: rviz_default_plugins/PointCloud2
      Name: FAST-LIO Body Cloud
      Enabled: true
      Topic:
        Value: /fastlio2/body_cloud
      Queue Size: 5
      Style: Points
      Size (Pixels): 2
      Color Transformer: Intensity
    - Class: rviz_default_plugins/PointCloud2
      Name: FAST-LIO World Cloud
      Enabled: true
      Topic:
        Value: /fastlio2/world_cloud
      Queue Size: 5
      Style: Points
      Size (Pixels): 1
      Color Transformer: AxisColor
      Axis: Z
      Decay Time: 200
    - Class: rviz_default_plugins/Path
      Name: LIO Path
      Enabled: true
      Topic:
        Value: /fastlio2/lio_path
      Line Style: Lines
      Line Width: 0.03
    - Class: rviz_default_plugins/MarkerArray
      Name: PGO Loop Markers
      Enabled: true
      Topic:
        Value: /pgo/loop_markers
  Global Options:
    Fixed Frame: map
    Frame Rate: 30
    Background Color: 48; 48; 48
  Tools:
    - Class: rviz_default_plugins/Interact
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Select
    - Class: rviz_default_plugins/FocusCamera
    - Class: rviz_default_plugins/Measure
    - Class: rviz_default_plugins/PublishPoint
      Topic:
        Value: /clicked_point
  Views:
    Current:
      Class: rviz_default_plugins/XYOrbit
      Distance: 30
      Pitch: 0.9
      Yaw: 0.8
Window Geometry:
  Width: 1600
  Height: 900
